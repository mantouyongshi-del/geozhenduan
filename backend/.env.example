# 六大基座大模型 API 密钥配置模版 (复制为 .env 并填入真实密钥)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_or_compatible_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=your_aliyun_dashscope_api_key_here
QWEN_API_KEY=your_aliyun_dashscope_api_key_here
DOUBAO_API_KEY=your_volcengine_ark_api_key_here
DOUBAO_MODEL_NAME=doubao-seed-2-0-mini-260215
MOONSHOT_API_KEY=your_moonshot_kimi_api_key_here
HUNYUAN_API_KEY=your_tencent_hunyuan_api_key_here
BAIDU_API_KEY=your_baidu_qianfan_api_key_here

# 厂商财务余额 API 鉴权凭据 (可选，用于算力燃料池实时对账)
ALIYUN_ACCESS_KEY_ID=your_aliyun_ak_here
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_sk_here
VOLC_ACCESS_KEY=your_volc_ak_here
VOLC_SECRET_KEY=your_volc_sk_here
BAIDU_ACCESS_KEY_ID=your_baidu_ak_here
BAIDU_ACCESS_KEY_SECRET=your_baidu_sk_here

# 高德开放平台 Web服务 REST API Key (用于地理事实标尺、POI消歧联想)
AMAP_KEY=your_amap_api_key_here

# 系统安全与数据库配置
GEO_SECRET_KEY=generate_a_random_secret_string_here
DATABASE_URL=sqlite:///geo_system.db

# 跨仓协作网络与内部鉴权 (02-品牌知识库 / 03-内容工厂)
DISTRIBUTION_API_URL=http://127.0.0.1:8003
KNOWLEDGE_API_URL=http://127.0.0.1:8002
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here
